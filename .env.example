PORT=3030
HOST=iam

DB_HOST=iam-db
DB_USER=userPostgres
DB_PASSWORD=userPostgresPassword
DB_NAME=iam

# Only checks password hashes of the older SHA-256 kind, sha256(password + PASSWORD_SALT); new hashes are scrypt with a
# salt of their own. Leave it empty in a new deployment, and when importing hashes that are a plain sha256(password).
PASSWORD_SALT=
# Encrypts user details and keys sign-in code hashes. Use a long random value, such as the output of
# `openssl rand -hex 32`, and never change it: details encrypted with the old value can't be read.
ENCRYPTION_SECRET=replace-with-a-long-random-secret

ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800
AUTH_CODE_EXPIRES_IN=45
AUTH_CODE_LENGTH=6
# Wrong codes a sign-in challenge accepts before it is spent
AUTH_CODE_MAX_ATTEMPTS=5

JWT_PRIVATE_KEY_FILE_OLD=keys/jwt.pem
JWT_PUBLIC_KEY_FILE_OLD=keys/jwt_pub.pem
JWT_PRIVATE_KEY_FILE=keys/jwt.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_pub.pem

# Times are stored without a zone, in this one: keep the zone a deployment started with
TZ=UTC

# DB Backup env vars
BKP_S3_BUCKET=bucket_name
BKP_S3_PREFIX=project_name
BKP_S3_ENDPOINT=https://some-objectstorage.com
AWS_DEFAULT_REGION=eu-central-1
AWS_EC2_METADATA_DISABLED=true
AWS_ACCESS_KEY_ID=key_id
AWS_SECRET_ACCESS_KEY=access_key
