{
  "name": "iam",
  "version": "1.0.7",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --delay 300ms --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "typeorm": "node ./node_modules/typeorm/cli.js -d ./dist/config/db.config.js",
    "typeorm:dev": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/config/db.config.ts"
  },
  "dependencies": {
    "@spalx/app-life-cycle-pkg": "^1.1.0",
    "@spalx/common-loggers-pkg": "1.0.5",
    "@spalx/http-transport-adapter": "1.0.11",
    "@spalx/iam-pkg": "2.0.3",
    "@spalx/rest-pkg": "^1.0.8",
    "@spalx/service-discovery-pkg": "^1.0.8",
    "@spalx/transport-pkg": "^1.3.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
